{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS a proposito: el API es NestJS (CJS) y necesita importar valores
    // en runtime, no solo tipos. Vite consume CJS sin problema; al reves no.
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
