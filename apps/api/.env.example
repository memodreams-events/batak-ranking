# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Las escrituras se saltan RLS con esta clave. NUNCA exponer en el front.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# PIN compartido que piden las escrituras (apuntar, crear eventos, borrar).
# Las lecturas son siempre públicas: la TV del stand no inicia sesión.
# En producción es obligatorio: el API se niega a arrancar sin él.
#
# Pon uno propio, no el del ejemplo. Este repo es público, así que cualquier
# valor escrito aquí es, por definición, un PIN que ya conoce todo el mundo.
# En local puedes dejarlo vacío y las escrituras van sin candado.
BATAK_PIN=

# Origen permitido por CORS en producción (sin barra final)
WEB_ORIGIN=https://batak-ranking-web.vercel.app
PORT=3000
